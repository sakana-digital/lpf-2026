{
  "name": "lpf-2026",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "4.1.9",
      "vite-plus": "latest"
    }
  },
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run website#dev",
    "build": "vp run website#build",
    "preview": "vp run website#preview",
    "test": "vp run -r test",
    "type-check": "vp run -r type-check",
    "format": "vp fmt",
    "prepare": "vp config"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@vue/compat": "beta",
    "@vue/compiler-core": "beta",
    "@vue/compiler-dom": "beta",
    "@vue/compiler-sfc": "beta",
    "@vue/compiler-ssr": "beta",
    "@vue/compiler-vapor": "beta",
    "@vue/reactivity": "beta",
    "@vue/runtime-core": "beta",
    "@vue/runtime-dom": "beta",
    "@vue/runtime-vapor": "beta",
    "@vue/server-renderer": "beta",
    "@vue/shared": "beta",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "beta"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.13",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
