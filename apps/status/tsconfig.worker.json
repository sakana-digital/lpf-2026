// The worker imports shared/ by relative path: we cannot verify that wrangler's
// bundler honours tsconfig paths, so the @shared alias is kept to the client only.
{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["worker/**/*", "worker-configuration.d.ts", "../../shared/**/*"]
}
