{
  "name": "status",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "dev:worker": "wrangler dev --no-types",
    "cf-typegen": "wrangler types --include-runtime=false",
    "migrate": "wrangler d1 migrations apply happo-sai-status",
    "seed": "wrangler d1 execute happo-sai-status --local --file seed.example.sql",
    "test": "vitest run",
    "token:issue": "bun scripts/issue-token.ts",
    "type-check": "vue-tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "deploy": "vp build && wrangler deploy"
  },
  "dependencies": {
    "vue": "beta"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^5.20260711.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.24.0"
  }
}
