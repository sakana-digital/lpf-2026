{
  "name": "status",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "panda codegen --silent && vp build",
    "dev:worker": "wrangler dev --no-types",
    "cf-typegen": "wrangler types --include-runtime=false",
    "migrate": "wrangler d1 migrations apply happo-sai-status",
    "seed": "wrangler d1 execute happo-sai-status --local --command 'DELETE FROM org_tokens; DELETE FROM admin_tokens; DELETE FROM org_status; DELETE FROM org_status_log' && wrangler d1 execute happo-sai-status --local --file seed.example.sql",
    "test": "panda codegen --silent && vitest run",
    "token:issue": "bun scripts/issue-token.ts",
    "type-check": "panda codegen --silent && vue-tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "deploy": "bun run build && wrangler deploy",
    "prepare": "panda codegen --silent"
  },
  "dependencies": {
    "vue": "beta"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^5.20260711.1",
    "@pandacss/dev": "^1.12.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^3.3.7",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.24.0"
  }
}
